{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akitakata-note",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // コンテンツDB（ADR-0002）。database_id は `wrangler d1 create akitakata-note`
  // 実行後に発行される値へ差し替える（未作成のうちはローカル --local のみ動作）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akitakata-note",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  // 画像ストレージ二層（ADR-0003）。バケットは `wrangler r2 bucket create` で作成。
  //  - ORIGINALS:   原本(EXIF/GPS付き)。非公開。配信経路に出さない
  //  - DERIVATIVES: 再エンコード済みの派生のみ。公開（CDN/ルート経由で配信）
  "r2_buckets": [
    { "binding": "ORIGINALS", "bucket_name": "akitakata-note-originals" },
    { "binding": "DERIVATIVES", "bucket_name": "akitakata-note-derivatives" }
  ],
  // Image Transformations（再エンコードでメタデータ除去, ADR-0003）
  "images": {
    "binding": "IMAGES"
  }
  // secrets（Claude APIキー等, ADR-0005）は wrangler secret で管理（このファイルには置かない）
  // DERIVATIVES_PUBLIC_BASE を vars に置けば /media ルートの代わりに R2カスタムドメイン配信に切替
}
